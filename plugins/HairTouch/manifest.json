{
  "schemaVersion": 2,
  "id": "local.nte.hair-touch",
  "name": "HairTouch FrontHair",
  "description": "Runtime bone-name matched front-hair interaction: mouse near head lifts the fringe, releasing eases it back. Hooks SkeletalMeshComponent tick so the write lands after animation.",
  "author": "akane",
  "license": "AGPL-3.0-only",
  "version": "0.3.0",
  "entry": "plugin.dll",
  "api": {
    "major": 1,
    "minMinor": 0,
    "maxMinor": 0
  },
  "games": [
    "nte"
  ],
  "builds": [
    "nte-*"
  ],
  "loadPhase": "game-ready",
  "services": [
    {
      "id": "anomaly.core",
      "minVersion": 1
    },
    {
      "id": "anomaly.interop.signature",
      "minVersion": 1
    },
    {
      "id": "anomaly.interop.hook",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.ue5.names",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.ui",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.input",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.ue5.framework",
      "minVersion": 1,
      "optional": true
    }
  ],
  "capabilities": [
    "game-events",
    "input",
    "interop-hook",
    "interop-signature",
    "memory-read",
    "memory-write",
    "nte-player-snapshot",
    "ue5-names",
    "ui"
  ]
}